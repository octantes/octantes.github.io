{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "octantes",
  "version": "0.1.0",
  "identifier": "ar.octantes.juego",
  "build": { "frontendDist": "../../export" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "octantes", "fullscreen": true, "resizable": true, "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}